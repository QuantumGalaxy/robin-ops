[Unit]
Description=Robin Ops isolated stock paper account
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/robin-ops
Environment=ROBIN_OPS_CREDENTIAL_FILE=/home/ubuntu/.config/robin-ops/oauth.enc
LoadCredential=oauth-key:/etc/robin-ops/oauth-key
ExecStart=/home/ubuntu/robin-ops/.venv/bin/python -m optionsagent.stock_paper --state-dir state/robinhood-paper --kill-file state/robinhood-paper/KILL
Restart=always
RestartSec=15
TimeoutStopSec=90
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/robin-ops/state /home/ubuntu/.config/robin-ops /home/ubuntu/.local/state/robin-ops

[Install]
WantedBy=multi-user.target
